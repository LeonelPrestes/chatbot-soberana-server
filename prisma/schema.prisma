// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  STUDENT      @map("estudante")
  PROFESSIONAL @map("profissional")

  @@map("tipo_usuario")
}

enum ClinicType {
  OWN        @map("propria")
  OUTSOURCED @map("terceirizada")

  @@map("tipo_clinica")
}

enum MaterialSupplier {
  DENTIST @map("dentista")
  CLINIC  @map("clinica")

  @@map("fornecedor_material")
}

enum PaymentMethod {
  COMMISSION   @map("comissao")
  MONTHLY_RENT @map("aluguel_mensal")
  FIXED_VALUE  @map("valor_fixo")

  @@map("forma_remuneracao")
}

enum ProfitType {
  MARKUP @map("markup")
  MARGIN @map("margem")

  @@map("tipo_lucro")
}

enum PricingStatus {
  DRAFT     @map("rascunho")
  FINALIZED @map("finalizada")
  ARCHIVED  @map("arquivada")

  @@map("status_precificacao")
}

enum ChangeSource {
  MANUAL @map("manual")
  AI     @map("ia")

  @@map("origem_alteracao")
}

enum ItemCategory {
  MATERIAL           @map("material")
  COMMISSION         @map("comissao")
  TAX                @map("imposto")
  ADDITIONAL_EXPENSE @map("gasto_adicional")
  OTHER              @map("outro")

  @@map("categoria_item")
}

enum MessageSender {
  USER @map("user")
  AI   @map("ia")

  @@map("remetente")
}

enum MessageStatus {
  PENDING   @map("pendente")
  CONFIRMED @map("confirmado")
  REJECTED  @map("rejeitado")

  @@map("status_mensagem")
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  name         String @map("nome")
  email        String @unique
  passwordHash String @map("senha_hash")

  emailVerifiedAt DateTime? @map("email_verificado_em")
  phone           String?   @map("telefone")
  cpf             String?   @unique
  specialty       String?   @map("especialidade")
  userType        UserType? @map("tipo_usuario")
  city            String?   @map("cidade")
  state           String?   @map("estado")

  // [RN-01] CRO e estado do CRO não são obrigatórios no cadastro.
  // stateCro só é obrigatório (validação de aplicação) se cro for preenchido.
  cro      String? @map("cro")
  stateCro String? @map("estado_cro")

  // Configurações padrão usadas como valores iniciais em novas precificações
  defaultCurrency     String?    @default("BRL") @map("moeda_padrao")
  defaultServiceTime  Int?       @map("tempo_atendimento_padrao")
  defaultProfitType   ProfitType @default(MARGIN) @map("tipo_lucro_padrao")
  defaultProfitMargin Decimal?   @map("margem_lucro_padrao") @db.Decimal(5, 4)
  defaultTaxRate      Decimal?   @map("aliquota_imposto_padrao") @db.Decimal(5, 4)
  defaultCardFee      Decimal?   @map("taxa_cartao_padrao") @db.Decimal(5, 4)

  termsAcceptedAt         DateTime @map("termos_aceitos_em")
  termsVersion            String   @map("versao_termos")
  privacyPolicyAcceptedAt DateTime @map("politica_privacidade_aceita_em")
  privacyPolicyVersion    String   @map("versao_politica_privacidade")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  clinics       Clinic[]
  pricings      Pricing[]
  conversations Conversation[]
  procedures    Procedure[]
  pricingAudits PricingAudit[]

  @@index([deletedAt])
  @@map("users")
}

model Specialty {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @map("codigo")
  name      String    @unique @map("nome")
  active    Boolean   @default(true) @map("ativo")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("especialidades")
}

model Clinic {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  name    String  @map("nome")
  city    String  @map("cidade")
  state   String  @map("estado")
  address String? @map("endereco")

  clinicType           ClinicType       @map("tipo_clinica")
  materialSupplier     MaterialSupplier @map("fornecedor_material")
  paymentMethod        PaymentMethod    @map("forma_remuneracao")
  commissionPercentage Decimal?         @map("percentual_comissao") @db.Decimal(5, 4)
  rentAmount           Decimal?         @map("valor_aluguel_sala") @db.Decimal(12, 2)
  otherExpenses        Decimal?         @map("outras_despesas_recorrentes") @db.Decimal(12, 2)
  notes                String?          @map("observacoes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  procedures  Procedure[]
  clinicCosts ClinicCosts[]
  pricings    Pricing[]

  @@index([userId])
  @@index([deletedAt])
  @@map("clinicas")
}

model Procedure {
  id       String  @id @default(uuid()) @db.Uuid
  code     String? @unique @map("codigo")
  userId   String? @map("user_id") @db.Uuid
  user     User?   @relation(fields: [userId], references: [id])
  clinicId String? @map("clinica_id") @db.Uuid
  clinic   Clinic? @relation(fields: [clinicId], references: [id])

  name        String  @map("nome")
  category    String? @map("categoria")
  averageTime Int?    @map("tempo_medio")
  description String? @map("descricao")
  active      Boolean @default(true) @map("ativo")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  pricings Pricing[]

  @@index([userId])
  @@index([clinicId])
  @@index([deletedAt])
  @@map("procedimentos")
}

// [D2] Snapshot de custos por período de vigência da clínica
model ClinicCosts {
  id       String @id @default(uuid()) @db.Uuid
  clinicId String @map("clinica_id") @db.Uuid
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  sixMonthFixedCost      Decimal   @map("custo_fixo_6m") @db.Decimal(12, 2)
  sixMonthVariableCost   Decimal   @map("custo_variavel_6m") @db.Decimal(12, 2)
  monthlyFixedCost       Decimal   @map("custo_fixo_mensal") @db.Decimal(12, 2)
  monthlyVariableCost    Decimal   @map("custo_variavel_mensal") @db.Decimal(12, 2)
  effectiveHoursPerMonth Decimal   @map("horas_efetivas_mes") @db.Decimal(6, 2)
  effectiveDate          DateTime  @map("data_vigencia") @db.Date
  effectiveEnd           DateTime? @map("vigencia_fim") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  pricings Pricing[]

  @@index([clinicId])
  @@index([deletedAt])
  @@map("clinica_custos")
}

model Pricing {
  id String @id @default(uuid()) @db.Uuid

  clinicId String @map("clinica_id") @db.Uuid
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  clinicCostsId String      @map("clinica_custos_id") @db.Uuid
  clinicCosts   ClinicCosts @relation(fields: [clinicCostsId], references: [id])

  pricingDate DateTime      @default(now()) @map("data_precificacao") @db.Date
  procedureId String        @map("procedimento_id") @db.Uuid
  procedure   Procedure     @relation(fields: [procedureId], references: [id])
  status      PricingStatus @default(DRAFT) @map("status")

  clinicalMinuteCost Decimal @default(0) @map("custo_minuto_clinico") @db.Decimal(12, 4)
  procedureTime      Int     @default(0) @map("tempo_procedimento")

  materialsCost  Decimal @default(0) @map("custo_materiais") @db.Decimal(12, 2)
  additionalCost Decimal @default(0) @map("custo_adicional") @db.Decimal(12, 2)
  totalCost      Decimal @default(0) @map("custo_total") @db.Decimal(12, 2)

  tax        Decimal @default(0) @map("imposto") @db.Decimal(5, 4)
  fees       Decimal @default(0) @map("taxas") @db.Decimal(5, 4)
  commission Decimal @default(0) @map("comissao") @db.Decimal(5, 4)
  charges    Decimal @default(0) @map("incidencias") @db.Decimal(5, 4)

  profitType     ProfitType @default(MARGIN) @map("tipo_lucro")
  profit         Decimal    @default(0) @map("lucro") @db.Decimal(5, 4)
  adjustedCost   Decimal    @default(0) @map("custo_corrigido") @db.Decimal(12, 2)
  suggestedPrice Decimal    @default(0) @map("preco_sugerido") @db.Decimal(12, 2)

  version Int @default(1)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items         PricingItem[]
  conversations Conversation[]
  audits        PricingAudit[]

  @@index([clinicId])
  @@index([userId])
  @@index([clinicCostsId])
  @@index([procedureId])
  @@index([deletedAt])
  @@map("precificacoes")
}

model PricingItem {
  id        String  @id @default(uuid()) @db.Uuid
  pricingId String  @map("precificacao_id") @db.Uuid
  pricing   Pricing @relation(fields: [pricingId], references: [id], onDelete: Cascade)

  category  ItemCategory @map("categoria")
  name      String       @map("nome")
  unitValue Decimal      @map("valor_unitario") @db.Decimal(12, 2)
  quantity  Decimal      @default(1) @map("quantidade") @db.Decimal(10, 2)
  source    ChangeSource @default(MANUAL) @map("origem")

  version Int @default(1)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([pricingId])
  @@index([deletedAt])
  @@map("itens_precificacao")
}

model Conversation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  pricingId String  @map("precificacao_id") @db.Uuid
  pricing   Pricing @relation(fields: [pricingId], references: [id])

  title String   @map("titulo")
  date  DateTime @map("data")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  messages Message[]

  @@index([userId])
  @@index([pricingId])
  @@index([deletedAt])
  @@map("conversas")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversa_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  sender  MessageSender @map("remetente")
  content String        @map("conteudo") @db.Text

  structuredPayload Json?         @map("payload_estruturado")
  status            MessageStatus @default(PENDING) @map("status")

  date DateTime @map("data")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([conversationId])
  @@index([deletedAt])
  @@map("mensagens")
}

model PricingAudit {
  id            String       @id @default(uuid()) @db.Uuid
  pricingId     String       @map("precificacao_id") @db.Uuid
  pricing       Pricing      @relation(fields: [pricingId], references: [id])
  field         String       @map("campo")
  previousValue Json?        @map("valor_anterior")
  newValue      Json?        @map("valor_novo")
  authorId      String?      @map("autor_id") @db.Uuid
  author        User?        @relation(fields: [authorId], references: [id])
  source        ChangeSource @map("origem")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  @@index([pricingId, createdAt])
  @@index([authorId])
  @@index([deletedAt])
  @@map("precificacao_auditoria")
}
