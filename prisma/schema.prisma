
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserExample {
  id        String          @id @default(uuid())
  fristName String
  lastName  String
  email     String          @unique
  password  String
  role      UserRoleExample @default(USER)
}

enum UserRoleExample {
  USER
  ADMIN
}
